{
  "$description": "Youtopia design tokens. Source of truth for tokens.css. Values are brand-tuned around the Youtopia magenta/purple identity.",
  "color": {
    "brand": {
      "magenta": {
        "50": "#FDF0F7", "100": "#FBDCEC", "200": "#F7B6D6", "300": "#F186BC", "400": "#EC4E9E",
        "500": "#E4197E", "600": "#C21169", "700": "#9C0E55", "800": "#741040", "900": "#4F0E2D"
      },
      "purple": {
        "50": "#F4EFFB", "100": "#E7DCF7", "200": "#CDB6ED", "300": "#AF88E0", "400": "#8B54CE",
        "500": "#6B2FB5", "600": "#58259A", "700": "#451D7A", "800": "#33165B", "900": "#22103E"
      }
    },
    "neutral": {
      "ink": {
        "50": "#F7F4FA", "100": "#ECE8F0", "200": "#DAD4DF", "300": "#BCB4C4", "400": "#948A9E",
        "500": "#74677F", "600": "#564A63", "700": "#3D3349", "800": "#2A2135", "900": "#1C1424", "950": "#140E1B"
      },
      "paper": "#FBF8FC",
      "white": "#FFFFFF"
    },
    "semantic": {
      "success": "#16A36B",
      "warning": "#C7810B",
      "danger": "#DC3055",
      "info": "#6B2FB5"
    }
  },
  "typography": {
    "family": {
      "display": "'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif",
      "text": "'Hanken Grotesk', ui-sans-serif, system-ui, -apple-system, sans-serif",
      "mono": "ui-monospace, 'SF Mono', 'Cascadia Code', 'Consolas', monospace"
    },
    "scale": {
      "display": { "size": "56px", "lineHeight": "1.0", "weight": 700 },
      "h1": { "size": "40px", "lineHeight": "1.05", "weight": 600 },
      "h2": { "size": "32px", "lineHeight": "1.1", "weight": 600 },
      "h3": { "size": "24px", "lineHeight": "1.2", "weight": 600 },
      "h4": { "size": "18px", "lineHeight": "1.3", "weight": 600 },
      "body": { "size": "16px", "lineHeight": "1.6", "weight": 400 },
      "small": { "size": "14px", "lineHeight": "1.5", "weight": 400 },
      "caption": { "size": "12px", "lineHeight": "1.4", "weight": 700, "letterSpacing": "0.1em", "transform": "uppercase" }
    }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "18px", "xl": "26px", "full": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(20,14,27,.06), 0 1px 3px rgba(20,14,27,.05)",
    "md": "0 4px 10px -2px rgba(20,14,27,.10), 0 2px 6px -2px rgba(20,14,27,.07)",
    "lg": "0 18px 40px -12px rgba(76,14,45,.22), 0 6px 14px -6px rgba(20,14,27,.10)"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": {
      "standard": "cubic-bezier(.2,0,0,1)",
      "out": "cubic-bezier(.16,1,.3,1)",
      "spring": "cubic-bezier(.34,1.56,.64,1)"
    }
  },
  "zIndex": {
    "base": 0, "dropdown": 1000, "sticky": 1100,
    "modalBackdrop": 1200, "modal": 1210, "toast": 1300, "tooltip": 1400
  },
  "chart": {
    "1": "#E4197E", "2": "#6B2FB5", "3": "#16A36B",
    "4": "#2E7CE4", "5": "#E0930F", "6": "#0EA5A5"
  }
}
